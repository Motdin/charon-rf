# ===== Required =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Robinhood Chain (EVM L2, chainId 4663) =====
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
WS_URL=wss://robinhood-rpc.publicnode.com
RPC_FALLBACK_URLS=https://robinhood-rpc.publicnode.com,https://rpc.mainnet.chain.robinhood.com

# ===== LLM (OpenAI-compatible) =====
ENABLE_LLM=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_CANDIDATE_PICK_COUNT=10
LLM_CANDIDATE_MAX_AGE_MS=600000

# ===== Trading mode: dry_run | confirm | live =====
TRADING_MODE=dry_run

# Live execution (only for live/confirm)
PRIVATE_KEY=
# Alamat di bawah SUDAH diverifikasi on-chain di Robinhood Chain (chainId 4663).
# ⚠️ Jangan ganti dengan alamat canonical Ethereum mainnet — alamat itu BUKAN
# kontrak di sini; bot sekarang menolak start di mode live/confirm jika begitu.
# V3 SwapRouter02 (verified "SwapRouter02" di Blockscout)
UNISWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
UNISWAP_V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
# V4 (mayoritas pool meme RH ber-quote ETH native → swap tanpa wrap WETH)
LIVE_V4_ENABLED=true
UNISWAP_UNIVERSAL_ROUTER=0x8876789976dEcBfCbBbe364623C63652db8C0904
UNISWAP_V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
UNISWAP_V4_QUOTER=0x8Dc178eFB8111BB0973Dd9d722ebeFF267c98F94
UNISWAP_V4_STATE_VIEW=0xF3334192D15450CdD385c8B70e03f9a6bD9E673b
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# WETH on Robinhood Chain
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# USDG stable on Robinhood Chain
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
LIVE_MIN_ETH_RESERVE=0.005
SLIPPAGE_BPS=300
SWAP_DEADLINE_SECONDS=300
# Unwrap balik otomatis jika wrap sudah terjadi tapi swap gagal total
LIVE_UNWRAP_ON_FAIL=true

# ===== Signals =====
# DexScreener (public, no key)
DEXSCREENER_ENABLED=true
DEXSCREENER_POLL_MS=30000
# On-chain Uniswap V4/V3 event watcher
ONCHAIN_EVENTS_ENABLED=true
ONCHAIN_POLL_MS=15000

# Pons launchpad (Robinhood Chain launch feed — public, no key)
# https://docs.ponsfamily.com/llms.txt
PONS_ENABLED=true
PONS_POLL_MS=30000
PONS_API_BASE=https://www.ponsfamily.com/api
PONS_LOOKBACK_MS=1800000

# Overlap: how many signal sources must agree
MIN_SOURCE_COUNT=2

# ===== Position monitor =====
POSITION_CHECK_MS=10000

# ===== Optional enrichment =====
BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api

# GMGN OpenAPI (primary enrichment — free tier only 5 weight/window)
# When disabled or weight exhausted, pipeline auto-falls back to DexScreener + Blockscout.
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_CHAIN=robinhood
GMGN_BASE_URL=https://openapi.gmgn.ai
GMGN_CACHE_TTL_MS=180000
GMGN_WEIGHT_BUDGET=5
GMGN_WEIGHT_WINDOW_MS=60000
# Be polite — official docs say 1 req / 5s. Lower this and you get banned.
GMGN_REQUEST_DELAY_MS=2500

MAX_OPEN_POSITIONS=3
DB_PATH=./charon-rh.sqlite
